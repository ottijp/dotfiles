#!/bin/zsh
set -euo pipefail

err() {
  echo "$*" >&2
}

# parse options

if [ "$#" -lt 1 ]; then
  err "usage: $0 <name> [<source_path>]"
  exit 1
fi

sandbox_name=$1
src_path=${2:-""}
if [[ -n "$src_path" ]]; then
  mount_source=true
  src_path=$(cd "$src_path" && pwd -P)
else
  mount_source=false
fi


# src_pathがworktreeの場合の共有gitディレクトリを特定する
common_git_dir=""
if [[ "$mount_source" == "true" ]]; then
  if git -C "$src_path" rev-parse --git-dir >/dev/null 2>&1; then
    common_git_dir=$(git -C "$src_path" rev-parse --path-format=absolute --git-common-dir)
  fi
fi


# create sandbox
# node:NN-bookworm-slim is better for less image size, but I don't use slim image becasue some of commands (e.g.`ps`) aren't included.

if ! msb inspect $sandbox_name >/dev/null 2>&1; then
  echo "sandbox '$sandbox_name' not found. creating..."
  args=()
  args+=(--name $sandbox_name)
  args+=(--replace)
  args+=(--cpus 2)
  args+=(--memory 2G)
  args+=(--root-disk 4G)
  [[ -d "$XDG_DATA_HOME/codex" ]] && args+=(--mount-dir "$XDG_DATA_HOME/codex:/root/.codex:rw")
  [[ -d "$XDG_DATA_HOME/agents" ]] && args+=(--mount-dir "$XDG_DATA_HOME/agents:/root/.agents:rw")
  if [[ "$mount_source" == "true" ]]; then
    # mount worktree directory as its original path for integrity of reverse reference from common git directory
    args+=(--mount-dir "${src_path}:/${src_path}:rw")
    args+=(--workdir "${src_path}")
    if [[ -n "$common_git_dir" && "$common_git_dir" != "$src_path/"* ]]; then
      # mount common git dir as its original path for git operations (e.g. refer to other branches).
      args+=(--mount-dir "${common_git_dir}:${common_git_dir}:rw")
    fi
  fi
  msb run "${args[@]}" node:24-bookworm -- npm install -g @openai/codex
fi
msb exec $sandbox_name -- codex --no-daemon -c "projects.$src_path.trust_level=trusted" "$@"
